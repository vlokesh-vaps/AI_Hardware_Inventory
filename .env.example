# ==============================================================================
# Hardware Inventory & Prometheus Monitoring Environment Configuration
# ==============================================================================

# Application Settings
SECRET_KEY=hardware-inventory-secret-key-2026
FLASK_ENV=production
PORT=5000

# Prometheus HTTP API Configuration (Pipeline B)
# Base URL of your Prometheus server (do not add trailing slash)
PROMETHEUS_URL=http://172.16.10.38:9090

# HTTP query timeout in seconds
PROMETHEUS_TIMEOUT=5

# In-memory monitoring cache TTL in seconds (reduces repeated queries to Prometheus)
MONITORING_CACHE_TTL_SECONDS=10

# Live Monitoring Alert Thresholds (percentages)
CPU_WARNING_PERCENT=80.0
CPU_CRITICAL_PERCENT=95.0
MEMORY_WARNING_PERCENT=85.0
MEMORY_CRITICAL_PERCENT=95.0
DISK_WARNING_PERCENT=85.0
DISK_CRITICAL_PERCENT=95.0

# Windows Services to Monitor (comma-separated service names)
MONITORED_SERVICES=Spooler,LanmanServer,wuauserv,EventLog

# Key Windows Processes to Track (comma-separated executable names)
MONITORED_PROCESSES=chrome.exe,sqlservr.exe,postgres.exe
